[Unit]
Description=SENTINEL-01 log forwarding to OPS-03
After=network.target cuas-console.service

[Service]
Type=simple
EnvironmentFile=/etc/sw/lab.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /usr/local/bin/log-forward.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
