# Shadow Watch lab — compose environment.
# Consumed by compose/docker-compose.yml and the control scripts.

# Exercise clock, in seconds. The wipe job fires this many seconds after
# sentinel-01 boots, destroying the staged export and the track log. Collect
# volatile evidence before it runs out.
#
# Default 2700 = 45 minutes. Give yourself more on a first run:
#   setup.ps1 -Minutes 60     /     bash setup.sh --minutes 60
# This is baked into the timer at BUILD time, so changing it here needs a
# rebuild of the sentinel-01 image (the setup script does that for you).
EXERCISE_WIPE_AFTER=2700

# Track generator cadence (seconds between sweeps) and sector count.
TRACK_INTERVAL=2
SECTOR_COUNT=6

# Availability gates used by the verifier.
AVAILABILITY_MIN=0.95
MAX_GAP_SECONDS=15
# Availability is measured over this rolling window (seconds).
AVAILABILITY_WINDOW=60

# Shared secret used to authenticate real tracks (HMAC). Forged tracks lack it.
TRACK_HMAC_SECRET=sw-lab-track-secret

# C2 sink (lives on the relay host). To be cut by the analyst — not the uplink.
C2_HOST=relay
C2_PORT=4443

# Legitimate uplink (sentinel-01 -> mission-control). Must NOT be cut.
UPLINK_HOST=mission-control
UPLINK_PORT=9000

# Whole-team password for the analyst account on every host.
ANALYST_PASSWORD=analyst
