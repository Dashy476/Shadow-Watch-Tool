# Runtime configuration baked into every host as /etc/sw/lab.env.
# systemd units read this via EnvironmentFile (systemd does not inherit the
# container environment). Keep the values in step with compose/.env.
TRACK_INTERVAL=2
SECTOR_COUNT=6
TRACK_HMAC_SECRET=sw-lab-track-secret
AVAILABILITY_WINDOW=60
UPLINK_HOST=mission-control
UPLINK_PORT=9000
C2_HOST=relay
C2_PORT=4443
EXERCISE_WIPE_AFTER=2700
